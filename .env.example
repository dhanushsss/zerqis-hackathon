# ---------------------------------------------------------------------------
# Alibi configuration. Copy to .env and fill in what you have.
# Every integration is optional: without keys Alibi still runs real sandboxed
# experiments, and labels model stages "heuristic" or "replay".
# All keys stay server-side; nothing here is exposed to the browser.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=8787
# Use 0.0.0.0 when serving behind a reverse proxy on a VM.
HOST=127.0.0.1
# Where SQLite, demo repositories, caches, and workspaces live (relative to repo root).
ALIBI_DATA_DIR=data
# Set to true for a public demo: rate-limits work, disables deletes/PRs/settings,
# and only investigates GitHub repositories you have allow-listed.
ALIBI_DEMO_READONLY=false

# --- NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) -----------
# Create a key at https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=
# Default works for most accounts; use the region URL shown in your dashboard if different.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TIMEOUT_MS=120000
NEBIUS_MAX_RETRIES=3
# Optional per-role model overrides. Leave empty to auto-select from the live
# /v1/models catalog (Lightning/Nano for triage, Super for reasoning, Ultra for patches).
# An override that is not in your catalog is ignored with a visible note.
ALIBI_MODEL_TRIAGE=
ALIBI_MODEL_REASONING=
ALIBI_MODEL_DEEP=
# Budget: maximum model calls per investigation, and characters of log context.
ALIBI_MAX_MODEL_CALLS=8
ALIBI_MAX_LOG_CHARS=120000

# --- Tavily (runtime external evidence) -------------------------------------
# https://app.tavily.com — used only when a hypothesis implicates a dependency or external service.
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=20000

# --- GitHub Actions ----------------------------------------------------------
# Fine-grained token. To investigate: Actions (read), Contents (read), Metadata (read).
# To open draft PRs as well: Contents (write), Pull requests (write).
GITHUB_TOKEN=
# Secret configured on the repository webhook (event: Workflow runs, content type JSON).
GITHUB_WEBHOOK_SECRET=
# Automatically start an investigation when a webhook reports a failed run.
ALIBI_AUTO_INVESTIGATE=false

# --- Sandbox runner (Docker) ---------------------------------------------------
# docker | disabled. Workloads run non-root, no capabilities, read-only root, no network during tests.
ALIBI_RUNNER=docker
ALIBI_NODE_IMAGE=node:20-bookworm-slim
ALIBI_MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
ALIBI_RUNNER_CPUS=1.5
ALIBI_RUNNER_MEMORY=1536m
ALIBI_RUNNER_TIMEOUT_SEC=180
ALIBI_RUNNER_INSTALL_TIMEOUT_SEC=420
ALIBI_RUNNER_MAX_OUTPUT_BYTES=524288
# Default number of repeated runs in the flake experiment (2–30).
ALIBI_REPEAT_DEFAULT=10

# --- Experimental: bounded agent loop (off by default) -------------------------
# Leave unset (or anything other than 1/true) for the default single-pass investigation.
# Not yet verified against the live Token Factory API. See README "Experimental: bounded agent loop".
ALIBI_LOOP=
# Loop iterations and decision calls (each capped at 4).
ALIBI_LOOP_MAX_ITERATIONS=4
ALIBI_LOOP_MAX_MODEL_CALLS=4
# Prompt + completion tokens across loop decision calls; checked between steps (may overshoot by one call).
ALIBI_LOOP_MAX_TOKENS=40000
# Loop wall-clock limit in ms; checked between steps (an in-flight call or experiment is not interrupted).
ALIBI_LOOP_MAX_MS=480000
# Sandbox test runs the loop may start, and the most runs one "repeat" may request (capped at 20).
ALIBI_LOOP_MAX_RUNS=30
ALIBI_LOOP_MAX_RUNS_PER_ACTION=10
# Tavily searches the loop may start (capped at 3; ignored without TAVILY_API_KEY).
ALIBI_LOOP_MAX_SEARCHES=2
